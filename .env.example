# Aperture File Server Configuration

# Server Port and Base URL
PORT=3000
BASE_URL=http://localhost:3000

# File Upload Settings
MAX_FILE_SIZE_MB=100
UPLOAD_DIRECTORY=./storage/uploads
DATABASE_PATH=./storage/database.sqlite
STORAGE_PROVIDER=local

# Optional: Comma-separated list of allowed extensions (leave blank to allow all standard files)
ALLOWED_EXTENSIONS=

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Pre-seeded Default API Keys (Automatically populated into SQLite on initial launch)
ADMIN_API_KEY=aperture_adm_secret_key_2026
UPLOAD_API_KEY=aperture_upl_secret_key_2026
READ_API_KEY=aperture_ro_secret_key_2026

# Future Cloud Storage (AWS S3 / MinIO / Cloudflare R2) - Optional
# S3_BUCKET_NAME=aperture-uploads
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
